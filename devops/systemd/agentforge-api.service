[Unit]
Description=AgentForge API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=agentforge
Group=agentforge
WorkingDirectory=/srv/agentforge/current
EnvironmentFile=/etc/agentforge/api.env
ExecStartPre=/srv/agentforge/current/migrate
ExecStart=/srv/agentforge/current/api
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
