[Unit]
Description=gofiber-gorm-next API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gofiber
Group=gofiber
WorkingDirectory=/srv/gofiber-gorm-next/current
EnvironmentFile=/etc/gofiber-gorm-next/gofiber-gorm-next.env
ExecStartPre=/srv/gofiber-gorm-next/current/migrate
ExecStart=/srv/gofiber-gorm-next/current/api
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
