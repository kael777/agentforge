APP_ENV=production
SERVICE_NAME=agentforge-api

# Public listener. The production unit binds loopback only and lets Nginx be
# the single public entrypoint.
HTTP_ADDR=127.0.0.1:55555
# Management listener. Never publish this port.
MANAGEMENT_ADDR=127.0.0.1:55556
HTTP_ALLOWED_ORIGINS=https://app.example.com

# Nginx on the same host. Remove this line if nothing proxies the service.
HTTP_TRUSTED_PROXIES=127.0.0.1

AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1m

DATABASE_DSN=agentforge:change-me@tcp(127.0.0.1:3306)/agentforge?charset=utf8mb4&parseTime=True&loc=UTC
DATABASE_MAX_IDLE_CONNS=5
DATABASE_MAX_OPEN_CONNS=20
DATABASE_CONN_MAX_LIFETIME=1h

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=agentforge-api
JWT_AUDIENCE=agentforge-web
JWT_TTL=24h

LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
