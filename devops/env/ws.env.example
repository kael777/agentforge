APP_ENV=production
SERVICE_NAME=agentforge-ws
LOG_LEVEL=info

# Nginx terminates TLS and proxies to this listener.
WS_ADDR=127.0.0.1:8090
WS_MANAGEMENT_ADDR=127.0.0.1:8091

WS_ALLOWED_ORIGINS=https://app.example.com
WS_ALLOW_EMPTY_ORIGIN=false

# Must match WS_TICKET_SECRET in the API service.
WS_TICKET_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
WS_TICKET_ISSUER=agentforge-api
WS_TICKET_AUDIENCE=agentforge-ws

# Nginx runs on the same host.
WS_TRUSTED_PROXIES=127.0.0.1

WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_PER_IP=20
WS_MAX_MESSAGE_BYTES=32768
WS_SEND_QUEUE_SIZE=256
WS_READ_TIMEOUT=90s
WS_WRITE_TIMEOUT=10s
WS_PING_INTERVAL=30s
WS_MESSAGE_RATE=20
WS_MESSAGE_BURST=40

# Must exceed the library's five second close handshake.
SHUTDOWN_TIMEOUT=20s
