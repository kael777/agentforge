# 复制为 .env 后修改。这个文件不含密码——密码在 secrets/ 目录里。

# 数据库名与账号（密码在 secrets/mysql_app.txt）
MYSQL_DATABASE=agentforge
MYSQL_USER=agentforge

# 宿主机端口。默认 13306，原因是宿主上很可能已经有一个 3306 的 MySQL。
# 冲突时改这里，不要改容器内的 3306。
MYSQL_HOST_PORT=13306

# 密码文件所在目录（相对本文件）
SECRETS_DIR=./secrets

# 只有启用 --profile with-redis 时才需要
# REDIS_PASSWORD=
