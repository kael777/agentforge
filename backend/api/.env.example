APP_ENV=development
SERVICE_NAME=agentforge-api
HTTP_ADDR=:55555
HTTP_ALLOWED_ORIGINS=http://localhost:5173

DATABASE_DSN=agentforge:agentforge@tcp(127.0.0.1:3306)/agentforge?charset=utf8mb4&parseTime=True&loc=UTC
DATABASE_MAX_IDLE_CONNS=5
DATABASE_MAX_OPEN_CONNS=20
DATABASE_CONN_MAX_LIFETIME=1h

# Use a different secret in every real environment. Minimum length: 32 characters.
JWT_SECRET=replace-this-with-at-least-32-characters
JWT_TTL=24h

LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

