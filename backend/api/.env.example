APP_ENV=development
SERVICE_NAME=agentforge-api

# Public listener. Only business routes are reachable from here.
HTTP_ADDR=:55555
# Management listener: /readyz, /version and /metrics. Keep it off the public
# interface; non-loopback binds must be opted into explicitly.
MANAGEMENT_ADDR=127.0.0.1:55556
HTTP_ALLOWED_ORIGINS=http://localhost:5173

# Optional: comma-separated proxy addresses allowed to supply X-Forwarded-For.
# Leave empty unless a reverse proxy actually fronts the service, otherwise a
# client can pick its own source IP and dodge per-IP rate limits.
HTTP_TRUSTED_PROXIES=

# Credential endpoint throttling, per source address and per process.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1m

DATABASE_DSN=agentforge:agentforge@tcp(127.0.0.1:3306)/agentforge?charset=utf8mb4&parseTime=True&loc=UTC
DATABASE_MAX_IDLE_CONNS=5
DATABASE_MAX_OPEN_CONNS=20
DATABASE_CONN_MAX_LIFETIME=1h

# Use a different secret in every real environment. Minimum length: 32 characters.
# Tokens carry this issuer and audience and are rejected when either differs.
JWT_SECRET=replace-this-with-at-least-32-characters
JWT_ISSUER=agentforge-api
JWT_AUDIENCE=agentforge-web
JWT_TTL=24h

# WebSocket tickets. Must match WS_TICKET_SECRET in the realtime service and must
# differ from JWT_SECRET, so one leaked secret cannot impersonate the other.
WS_TICKET_SECRET=dev-ws-ticket-secret-0123456789ab
WS_TICKET_ISSUER=agentforge-api
WS_TICKET_AUDIENCE=agentforge-ws
WS_TICKET_TTL=30s

LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
