APP_ENV=development
SERVICE_NAME=agentforge-ws
LOG_LEVEL=info

# Public listener. Browsers connect here through the Vite proxy in development
# and through Nginx in production.
WS_ADDR=:8090
# Management listener: /readyz, /version and /metrics. Keep it off the public
# interface.
WS_MANAGEMENT_ADDR=127.0.0.1:8091

# Exact origin allowlist. A wildcard is rejected at startup. The Vite dev server
# origin has to be listed here or the browser handshake is refused.
WS_ALLOWED_ORIGINS=http://localhost:5173
# Set to true only for non-browser clients that send no Origin header.
WS_ALLOW_EMPTY_ORIGIN=false

# Must be identical to WS_TICKET_SECRET in the API service.
WS_TICKET_SECRET=dev-ws-ticket-secret-0123456789ab
WS_TICKET_ISSUER=agentforge-api
WS_TICKET_AUDIENCE=agentforge-ws

# Optional: addresses allowed to supply X-Forwarded-For. Leave empty unless a
# reverse proxy fronts this service, otherwise clients can pick their own IP.
WS_TRUSTED_PROXIES=

# Connection and message limits.
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_PER_IP=20
WS_MAX_MESSAGE_BYTES=32768
WS_SEND_QUEUE_SIZE=256
WS_READ_TIMEOUT=90s
WS_WRITE_TIMEOUT=10s
WS_PING_INTERVAL=30s
WS_MESSAGE_RATE=20
WS_MESSAGE_BURST=40

SHUTDOWN_TIMEOUT=20s
